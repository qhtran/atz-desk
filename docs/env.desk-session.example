# DEV only — copy to /opt/atz-desk/.env.desk-session on VPS (chmod 600).
# docker-compose.dev.yml loads this via env_file for service `api`.
# Do NOT commit real secrets. Prod atz.vn keeps ForwardAuth-only (no ROPC).

DESK_SESSION_AUTH=1
DESK_SESSION_SECRET=change-me-long-random
DESK_SESSION_SECURE=1
DESK_SESSION_TTL_SEC=43200

# Authentik OIDC application with Password grant enabled
AUTHENTIK_TOKEN_URL=https://auth.atz.vn/application/o/token/
AUTHENTIK_USERINFO_URL=https://auth.atz.vn/application/o/userinfo/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_SCOPE=openid profile email
