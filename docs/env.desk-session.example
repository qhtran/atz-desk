# Copy to /opt/atz-desk/.env.desk-session (chmod 600). Do NOT commit real secrets.
# Loaded by api in docker-compose.dev.yml and docker-compose.prod-desk.yml (required: false).
# ForwardAuth headers vẫn được ưu tiên khi nginx đã gắn X-Authentik-*.

DESK_SESSION_AUTH=1
DESK_SESSION_SECRET=change-me-long-random
DESK_SESSION_SECURE=1
DESK_SESSION_TTL_SEC=43200

# Authentik Flow Executor (user password + optional TOTP).
# OAuth grant_type=password only accepts App Password tokens, not account passwords.
# Flow slug desk-ropc-authentication: identification(+password) → MFA validate → login.
AUTHENTIK_FLOW_URL=https://auth.atz.vn/api/v3/flows/executor/desk-ropc-authentication/

# MFA pending state TTL in Redis (seconds) between password OK and OTP submit
# DESK_MFA_TTL_SEC=300

# Optional overrides:
# AUTHENTIK_BASE_URL=https://auth.atz.vn
# AUTHENTIK_AUTH_FLOW_SLUG=desk-ropc-authentication
# AUTHENTIK_USERS_ME_URL=https://auth.atz.vn/api/v3/core/users/me/
