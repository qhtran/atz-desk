{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Run Streamlit app",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/streamlit run app.py",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    },
    {
      "label": "Run Pytest",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/bin/pytest -q",
      "problemMatcher": [],
      "group": {
        "kind": "test",
        "isDefault": true
      }
    }
  ]
}
