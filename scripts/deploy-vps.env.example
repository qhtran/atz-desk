# Copy → scripts/deploy-vps.env (gitignore). Không commit secret.

# SSH host (alias ~/.ssh/config hoặc user@ip) — bắt buộc cho: ./scripts/deploy-vps.sh dev
ATZ_VPS_SSH=vps

# Prod / legacy trên VPS
ATZ_VPS_DIR=/opt/vnstocks

# ATZ Desk dev stack (dev.atz.vn)
ATZ_VPS_DIR_DEV=/opt/atz-desk

# Branch deploy (để trống = branch hiện tại khi chạy script)
# ATZ_VPS_BRANCH=main
