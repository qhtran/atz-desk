# Dev image: FastAPI priceboard + mock SSI worker (Python 3.11, auto-reload)
FROM python:3.11-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    FRONTEND_DIR=/app/frontend \
    OHLCV_BARS_DIR=/app/data/ohlcv \
    F3_THEMES_CONFIG=/app/config/sector_themes_f3.yaml

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend /app/backend
COPY frontend /app/frontend
COPY config/priceboard.yaml /app/config/priceboard.yaml
COPY config/ingestion.yaml /app/config/ingestion.yaml
COPY config/sector_themes_f3.yaml /app/config/sector_themes_f3.yaml
COPY config/advisor_score.yaml /app/config/advisor_score.yaml
# F3 + iBoard daily (legacy analysis — port tối thiểu, ADR 0009)
COPY src/atz/analysis/f3_alerts.py src/atz/analysis/candles.py src/atz/analysis/technical.py src/atz/analysis/__init__.py /app/atz_pkg/analysis/
COPY src/atz/config.py /app/atz_pkg/config.py
COPY src/atz/storage/__init__.py src/atz/storage/paths.py /app/atz_pkg/storage/
COPY src/atz/engine/__init__.py src/atz/engine/advisor_score.py /app/atz_pkg/engine/
COPY src/atz/filters/__init__.py src/atz/filters/base.py src/atz/filters/_net.py \
    src/atz/filters/rsi.py src/atz/filters/macd.py src/atz/filters/ma.py \
    src/atz/filters/candle.py src/atz/filters/volume.py src/atz/filters/foreign.py \
    src/atz/filters/bollinger.py src/atz/filters/adx.py src/atz/filters/atr.py \
    /app/atz_pkg/filters/

EXPOSE 8000

# Default: API with reload. Override command for ssi-worker service.
CMD ["uvicorn", "backend.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload", "--reload-dir", "/app/backend", "--reload-dir", "/app/frontend"]
